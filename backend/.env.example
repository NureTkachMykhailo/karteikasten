# From Google Cloud Console → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=

LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
